generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  TUTOR
  STUDENT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ
  taughtClasses Class[]      @relation("TutorClasses")
  enrollments   Enrollment[]
  attendances   Attendance[]
  submissions   Submission[]
}

model Class {
  id          String   @id @default(uuid())
  name        String
  description String?
  subject     String
  tutorId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Quan hệ
  tutor     User         @relation("TutorClasses", fields: [tutorId], references: [id])
  students  Enrollment[]
  schedules Schedule[]
  materials Material[]
}

// Bảng trung gian n-n: Học sinh tham gia lớp
model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  joinedAt  DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id])
  class   Class @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
}

enum ScheduleType {
  ONLINE
  OFFLINE
}

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// Lịch học của lớp (Ca dạy)
model Schedule {
  id        String         @id @default(uuid())
  classId   String
  title     String? // Tên buổi học (VD: Buổi 1: Ôn tập đại số)
  date      DateTime       @db.Date
  startTime String // VD: "08:00"
  endTime   String // VD: "10:00"
  type      ScheduleType   @default(OFFLINE)
  status    ScheduleStatus @default(SCHEDULED)
  createdAt DateTime       @default(now())

  class       Class        @relation(fields: [classId], references: [id])
  attendances Attendance[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// Điểm danh
model Attendance {
  id         String           @id @default(uuid())
  scheduleId String
  studentId  String
  status     AttendanceStatus @default(PRESENT)
  note       String?

  schedule Schedule @relation(fields: [scheduleId], references: [id])
  student  User     @relation(fields: [studentId], references: [id])

  @@unique([scheduleId, studentId])
}

enum MaterialType {
  DOCUMENT
  VIDEO
  ASSIGNMENT
}

// Tài liệu và Bài tập
model Material {
  id          String       @id @default(uuid())
  classId     String
  title       String
  description String?
  fileUrl     String? // Link tới AWS S3 / Cloudinary
  type        MaterialType @default(DOCUMENT)
  dueDate     DateTime? // Dùng cho type = ASSIGNMENT
  createdAt   DateTime     @default(now())

  class       Class        @relation(fields: [classId], references: [id])
  submissions Submission[]
}

// Nộp bài tập
model Submission {
  id          String   @id @default(uuid())
  materialId  String
  studentId   String
  fileUrl     String?
  content     String?  @db.Text
  score       Float?
  feedback    String?  @db.Text
  submittedAt DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
  student  User     @relation(fields: [studentId], references: [id])

  @@unique([materialId, studentId])
}
